<!DOCTYPE html>
<html>
<head>
    <title>Lists in HTML</title>
</head>

<body>

    <h1>Lists in HTML</h1>

    <!-- Ordered List -->
    <h2>1. Ordered List</h2>
    <ol>
        <li>HTML</li>
        <li>CSS</li>
        <li>JavaScript</li>
        <li>Java</li>
    </ol>

    <!-- Unordered List -->
    <h2>2. Unordered List</h2>
    <ul>
        <li>Apple</li>
        <li>Mango</li>
        <li>Banana</li>
        <li>Grapes</li>
    </ul>

    <!-- Nested List -->
    <h2>3. Nested List</h2>
    <ul>
        <li>Programming Languages
            <ul>
                <li>C</li>
                <li>Java</li>
                <li>Python</li>
            </ul>
        </li>

        <li>Web Technologies
            <ul>
                <li>HTML</li>
                <li>CSS</li>
                <li>JavaScript</li>
            </ul>
        </li>
    </ul>

    <!-- Ordered List inside Unordered List -->
    <h2>4. Ordered List inside Unordered List</h2>
    <ul>
        <li>Web Development
            <ol>
                <li>HTML</li>
                <li>CSS</li>
                <li>JavaScript</li>
            </ol>
        </li>

        <li>Database
            <ol>
                <li>MySQL</li>
                <li>Oracle</li>
                <li>MongoDB</li>
            </ol>
        </li>
    </ul>

    <!-- Definition List -->
    <h2>5. Definition List</h2>
    <dl>
        <dt><b>HTML</b></dt>
        <dd>HTML stands for HyperText Markup Language.</dd>

        <dt><b>CSS</b></dt>
        <dd>CSS stands for Cascading Style Sheets.</dd>

        <dt><b>JavaScript</b></dt>
        <dd>JavaScript is used to make web pages interactive.</dd>
    </dl>

</body>
</html>
